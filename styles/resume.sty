\ProvidesPackage{resume}

% ============================================================
% Colors
% ============================================================

\definecolor{PrimaryText}{HTML}{202124}
\definecolor{SecondaryText}{HTML}{4B5563}
\definecolor{Accent}{HTML}{1F4E79}

% ============================================================
% General
% ============================================================

\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}

% ============================================================
% Lists
% ============================================================

\setlist[itemize]{
    leftmargin=14pt,
    itemsep=1pt,
    topsep=2pt,
    parsep=0pt,
    partopsep=0pt
}

% ============================================================
% Sections
% ============================================================

\titleformat{\section}
    {\normalsize\bfseries\color{PrimaryText}}
    {}
    {0pt}
    {}
    [\vspace{-4pt}\titlerule]

\titlespacing*{\section}
    {0pt}
    {7pt}
    {4pt}

% ============================================================
% Header
% ============================================================

\newcommand{\makecvheader}{

    \begin{center}

        {\fontsize{22}{26}\selectfont
        \bfseries
        \color{PrimaryText}
        \CandidateName
        }

        \vspace{2pt}

        {\large
        \bfseries
        \color{Accent}
        \CandidateTitle
        }

        \vspace{5pt}

        {\small
        \color{SecondaryText}

        \href{mailto:\CandidateEmail}{\CandidateEmail}
        \quad\textbar\quad
        \href{https://\CandidateLinkedIn}{LinkedIn}
        \quad\textbar\quad
        \href{https://\CandidateGitHub}{Hamgit}
        \quad\textbar\quad
        \CandidateLocation

        }

    \end{center}

    \vspace{1pt}
}

% ============================================================
% Experience
% ============================================================

\newcommand{\experienceentry}[3]{

    \textbf{\color{PrimaryText}#1}
    \hfill
    {\small\color{SecondaryText}#3}

    \textit{\color{SecondaryText}#2}

    \vspace{1pt}
}

% ============================================================
% Project
% ============================================================

\newcommand{\projectentry}[2]{

    \textbf{\color{PrimaryText}#1}

    {\small\color{SecondaryText}#2}

    \vspace{1pt}
}

